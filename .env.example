# Copy to .env.local for development. In production, set these in your host's panel BEFORE building: the build reads them.

# Supabase. Leave both empty to run the built-in demo catalog; set both to run on your own project.
# Dashboard → Connect (or Project Settings → API Keys): the project URL and the publishable key (sb_publishable_…).
# A legacy anon key also works, here or as NEXT_PUBLIC_SUPABASE_ANON_KEY. Never put the secret key here: it goes only in SUPABASE_SECRET_KEY below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The site's public address, for canonical links, Open Graph images and the sitemap. On https:// the admin's session cookie
# is also marked Secure. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Checkout (optional; see docs/CHECKOUT.md). Leave empty and the cart shows "Checkout unavailable". All server-only.
# SUPABASE_SECRET_KEY=          the project's secret key (sb_secret_…), for writing orders. Never a NEXT_PUBLIC_ variable.
# STRIPE_SECRET_KEY=            sk_test_… (live keys are refused unless CHECKOUT_ALLOW_LIVE_PAYMENTS=true)
# STRIPE_WEBHOOK_SECRET=        whsec_… from the endpoint for /api/webhooks/stripe
# CHECKOUT_SHIPPING_COUNTRIES=  where you ship, e.g. US or US,CA
# CHECKOUT_SHIPPING_CENTS=      flat shipping per order in cents, e.g. 2500 (0 = free)
# CHECKOUT_TAX=                 none (prices are final) or stripe (Stripe Tax)
